-- ============================================================================
-- AIM LOOP
-- ============================================================================
local camLock = false
local function lockCamera()
    if camLock then return end
    cam.CameraType = Enum.CameraType.Scriptable
    camLock = true
end
local function unlockCamera()
    if not camLock then return end
    cam.CameraType = Enum.CameraType.Custom
    camLock = false
end

RunService.RenderStepped:Connect(function(dt)
    local aimActive = CFG.Aimbot or CFG.Aimlock
    fovCircle.Visible = CFG.FOVRing and aimActive
    if fovCircle.Visible then
        local vp = cam.ViewportSize
        fovCircle.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
        fovCircle.Size = UDim2.fromOffset(CFG.AimbotFOV * 2, CFG.AimbotFOV * 2)
        fovStroke.Color = CFG.FOVRingColor
    end

    if not aimActive then
        unlockCamera()
        return
    end

    local t = getBestTarget()
    if not t then
        unlockCamera()
        return
    end

    lockCamera()

    if CFG.Aimlock then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, t.Position)
    elseif CFG.Aimbot then
        local goal = CFrame.lookAt(cam.CFrame.Position, t.Position)
        if CFG.AimbotSmooth <= 0.05 then
            cam.CFrame = goal
        else
            local s = math.clamp(CFG.AimbotSmooth, 0.05, 1.0)
            local alpha = 1 - math.pow(1 - s, dt * 60)
            cam.CFrame = cam.CFrame:Lerp(goal, alpha)
        end
    end
end)

-- ============================================================================
-- ESP — universal highlight + tags
-- ============================================================================
local tagFolder = workspace:FindFirstChild("UNIV_Tags") or Instance.new("Folder")
tagFolder.Name = "UNIV_Tags"
tagFolder.Parent = workspace

local function entityColor(m)
    if CFG.TeamColors then
        local mine = getMyTeam()
        local theirs = getTeamOf(m)
        if mine and theirs and tostring(mine) == tostring(theirs) then
            return Color3.fromRGB(80, 220, 120)
        end
        if theirs then
            return Color3.fromRGB(230, 70, 70)
        end
        -- no team info: neutral
        return CFG.ESPColor
    end
    return CFG.ESPColor
end

local function buildESPFor(m)
    if not m or m == chr(lp) then return end
    local existing = m:FindFirstChild("UNIV_HL")
    if existing then existing:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "UNIV_HL"
    hl.Adornee = m
    hl.FillColor = entityColor(m)
    hl.OutlineColor = hl.FillColor
    hl.FillTransparency = CFG.ESPFill
    hl.OutlineTransparency = CFG.ESPOutline
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = CFG.ESP
    hl.Parent = m
end

local function buildTagFor(m)
    if not m or m == chr(lp) then return end
    local pl = Players:GetPlayerFromCharacter(m)
    local key = pl and pl.Name or m.Name
    local old = tagFolder:FindFirstChild(key)
    if old then old:Destroy() end
    local hrp = modelRoot(m)
    if not hrp then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = key
    bb.Size = UDim2.new(0, 160, 0, 36)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = hrp
    bb.Parent = tagFolder

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Name = "nameLbl"
    nameLbl.BackgroundTransparency = 1
    nameLbl.Size = UDim2.new(1, 0, 0, 18)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 13
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextStrokeTransparency = 0.5
    nameLbl.Text = key

    local distLbl = Instance.new("TextLabel", bb)
    distLbl.Name = "distLbl"
    distLbl.BackgroundTransparency = 1
    distLbl.Position = UDim2.new(0, 0, 0, 18)
    distLbl.Size = UDim2.new(1, 0, 0, 16)
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 12
    distLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    distLbl.TextStrokeTransparency = 0.5
    distLbl.Text = ""
end

local function updateESP()
    if not CFG.ESP then
        -- hide everything
        for _, m in ipairs(scanTargets()) do
            local hl = m:FindFirstChild("UNIV_HL")
            if hl then hl.Enabled = false end
        end
        for _, bb in ipairs(tagFolder:GetChildren()) do
            if bb:IsA("BillboardGui") then bb.Enabled = false end
        end
        return
    end

    for _, m in ipairs(scanTargets()) do
        local d = distanceTo(m)
        local show = d <= CFG.ESPMaxDist
        local hl = m:FindFirstChild("UNIV_HL")
        if not hl then
            buildESPFor(m)
            hl = m:FindFirstChild("UNIV_HL")
        end
        if hl then
            hl.Enabled = show
            hl.FillColor = entityColor(m)
            hl.OutlineColor = hl.FillColor
            hl.FillTransparency = CFG.ESPFill
            hl.OutlineTransparency = CFG.ESPOutline
        end

        local pl = Players:GetPlayerFromCharacter(m)
        local key = pl and pl.Name or m.Name
        local bb = tagFolder:FindFirstChild(key)
        if not bb then
            buildTagFor(m)
            bb = tagFolder:FindFirstChild(key)
        end
        if bb then
            local want = show and (CFG.Distance or CFG.NameTags)
            bb.Enabled = want
            if want then
                local nameLbl = bb:FindFirstChild("nameLbl")
                local distLbl = bb:FindFirstChild("distLbl")
                if nameLbl then nameLbl.Visible = CFG.NameTags end
                if distLbl then
                    distLbl.Visible = CFG.Distance
                    distLbl.Text = math.floor(d) .. "m"
                end
            end
        end
    end
end

-- periodic ESP refresh (cheap, doesn't need every frame)
local espTimer = 0
RunService.RenderStepped:Connect(function(dt)
    espTimer = espTimer + dt
    if espTimer >= 0.15 then
        espTimer = 0
        pcall(updateESP)
    end
end)

-- character respawn rebuild
local function rebuildAll()
    task.wait(0.4)
    for _, m in ipairs(scanTargets()) do
        buildESPFor(m)
        buildTagFor(m)
    end
end

Players.PlayerAdded:Connect(function(pl)
    pl.CharacterAdded:Connect(rebuildAll)
    rebuildAll()
end)
lp.CharacterAdded:Connect(rebuildAll)


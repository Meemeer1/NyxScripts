local function chr(p) return p and p.Character end
local function root(p) local c = chr(p); return c and c:FindFirstChild("HumanoidRootPart") end
local function hum(p)  local c = chr(p); return c and c:FindFirstChildOfClass("Humanoid") end

-- universal alive check: works on players and NPCs, rejects corpses
local function isAliveModel(m)
    if not m or not m:IsA("Model") then return false end
    if m == chr(lp) then return false end
    if m.Parent ~= workspace then return false end

    local h = m:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if h.Health <= 0 then return false end

    local st = h:GetState()
    if st == Enum.HumanoidStateType.Dead then return false end
    if st == Enum.HumanoidStateType.Dying then return false end

    if m:FindFirstChild("Ragdoll") then return false end
    if m:GetAttribute("Dead") == true then return false end
    if m:GetAttribute("IsDead") == true then return false end
    if m:GetAttribute("Alive") == false then return false end

    -- needs at least one part for a screen position
    if not m:FindFirstChild("HumanoidRootPart")
       and not m:FindFirstChild("Head")
       and not m:FindFirstChild("UpperTorso")
       and not m:FindFirstChild("Torso") then
        return false
    end
    return true
end

-- resolve a root-ish part for distance / position
local function modelRoot(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart")
        or m:FindFirstChild("Head")
        or m:FindFirstChild("UpperTorso")
        or m:FindFirstChild("Torso")
end

local function distanceTo(m)
    local a, b = root(lp), modelRoot(m)
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end

-- universal team check: tries Player.Team, attributes, then falls back to permissive
local function getTeamOf(obj)
    local pl = Players:GetPlayerFromCharacter(obj)
    if pl then
        if pl.Team then return pl.Team end
        local attr = pl:GetAttribute("Team") or pl:GetAttribute("team")
        if attr then return tostring(attr) end
        local ls = pl:FindFirstChild("leaderstats")
        if ls then
            local t = ls:FindFirstChild("Team")
            if t then return tostring(t.Value) end
        end
        return nil
    end
    -- NPC: check attributes
    local attr = obj:GetAttribute("Team") or obj:GetAttribute("team")
    if attr then return tostring(attr) end
    return nil
end

local function getMyTeam()
    if lp.Team then return lp.Team end
    local attr = lp:GetAttribute("Team") or lp:GetAttribute("team")
    if attr then return tostring(attr) end
    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        local t = ls:FindFirstChild("Team")
        if t then return tostring(t.Value) end
    end
    return nil
end

local function isTeammate(obj)
    local mine = getMyTeam()
    local theirs = getTeamOf(obj)
    if mine == nil or theirs == nil then return false end
    return tostring(mine) == tostring(theirs)
end

local function hasTool()
    local ch = chr(lp)
    if not ch then return false end
    return ch:FindFirstChildOfClass("Tool") ~= nil
end


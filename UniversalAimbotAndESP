-- ============================================================================
-- TARGET SCAN
-- ============================================================================
local function scanTargets()
    local out = {}
    local seen = {}

    local function add(m)
        if not m or seen[m] then return end
        seen[m] = true
        local pl = Players:GetPlayerFromCharacter(m)
        if pl then
            if not CFG.IncludePlayers or pl == lp then return end
        else
            if not CFG.IncludeNPCs then return end
        end
        if isAlive(m) then
            table.insert(out, m)
        end
    end

    if CFG.IncludePlayers then
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= lp then add(pl.Character) end
        end
    end

    if CFG.IncludeNPCs then
        local function walk(container, depth)
            if depth > 4 then return end
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Model") then
                    add(child)
                elseif child:IsA("Folder") then
                    walk(child, depth + 1)
                end
            end
        end
        walk(workspace, 0)
    end

    return out
end

local function choosePart(m, prefer)
    local order = { prefer, "Head", "UpperTorso", "Torso", "HumanoidRootPart" }
    for _, name in ipairs(order) do
        if name then
            local p = m:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p end
        end
    end
    return nil
end

local function getBestTarget()
    local vp = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    local bestPart, bestScore = nil, math.huge

    for _, m in ipairs(scanTargets()) do
        local skip = false
        if CFG.TeamCheck and isTeammate(m) then skip = true end
        if distanceTo(m) > CFG.MaxDist then skip = true end
        if CFG.RequireTool and not hasTool() then skip = true end

        if not skip then
            local blocked = false
            if CFG.WallCheck then
                local me = root(lp)
                local them = modelRoot(m)
                if me and them then
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { m, chr(lp) }
                    local res = workspace:Raycast(me.Position, them.Position - me.Position, params)
                    if res then blocked = true end
                end
            end

            if not blocked then
                local pt = choosePart(m, CFG.AimbotPart)
                if pt then
                    local sp = cam:WorldToViewportPoint(pt.Position)
                    local sd = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
                    if sd <= CFG.AimbotFOV and sd < bestScore then
                        bestScore = sd
                        bestPart = pt
                    end
                end
            end
        end
    end
    return bestPart
end

-- forward-declared helpers (used by getBestTarget above)
local function distanceTo(m)
    local a, b = root(lp), modelRoot(m)
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end


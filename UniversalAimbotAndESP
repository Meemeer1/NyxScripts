local tagFolder = workspace:FindFirstChild("RIV_Tags") or Instance.new("Folder")
tagFolder.Name = "RIV_Tags"
tagFolder.Parent = workspace

local function entityColor(m)
    if CFG.TeamColors then
        local pl = Players:GetPlayerFromCharacter(m)
        if pl and lp.Team and pl.Team == lp.Team then
            return Color3.fromRGB(80, 220, 120)
        end
        if pl then return Color3.fromRGB(230, 70, 70) end
    end
    return CFG.ESPColor
end

local function buildESPFor(m)
    if not m or m == chr(lp) then return end
    local existing = m:FindFirstChild("RIV_HL")
    if existing then existing:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "RIV_HL"
    hl.Adornee = m
    hl.FillColor = entityColor(m)
    hl.OutlineColor = hl.FillColor
    hl.FillTransparency = CFG.ESPFill
    hl.OutlineTransparency = CFG.ESPOutline
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = CFG.ESP
    hl.Parent = m
end

local function buildTagFor(m)
    if not m or m == chr(lp) then return end
    local pl = Players:GetPlayerFromCharacter(m)
    local key = pl and pl.Name or m.Name
    local old = tagFolder:FindFirstChild(key)
    if old then old:Destroy() end
    local hrp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
    if not hrp then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = key
    bb.Size = UDim2.new(0, 160, 0, 36)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = hrp
    bb.Parent = tagFolder

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Name = "nameLbl"
    nameLbl.BackgroundTransparency = 1
    nameLbl.Size = UDim2.new(1, 0, 0, 18)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 13
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextStrokeTransparency = 0.5
    nameLbl.Text = key

    local distLbl = Instance.new("TextLabel", bb)
    distLbl.Name = "distLbl"
    distLbl.BackgroundTransparency = 1
    distLbl.Position = UDim2.new(0, 0, 0, 18)
    distLbl.Size = UDim2.new(1, 0, 0, 16)
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 12
    distLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    distLbl.TextStrokeTransparency = 0.5
    distLbl.Text = ""
end

local function updateESP()
    if not CFG.ESP then
        for _, m in ipairs(scanTargets()) do
            local hl = m:FindFirstChild("RIV_HL")
            if hl then hl.Enabled = false end
        end
        for _, bb in ipairs(tagFolder:GetChildren()) do
            if bb:IsA("BillboardGui") then bb.Enabled = false end
        end
        return
    end

    for _, m in ipairs(scanTargets()) do
        local d = distanceTo(m)
        local show = d <= CFG.ESPMaxDist
        local hl = m:FindFirstChild("RIV_HL")
        if not hl then
            buildESPFor(m)
            hl = m:FindFirstChild("RIV_HL")
        end
        if hl then
            hl.Enabled = show
            hl.FillColor = entityColor(m)
            hl.OutlineColor = hl.FillColor
            hl.FillTransparency = CFG.ESPFill
            hl.OutlineTransparency = CFG.ESPOutline
        end

        local pl = Players:GetPlayerFromCharacter(m)
        local key = pl and pl.Name or m.Name
        local bb = tagFolder:FindFirstChild(key)
        if not bb then
            buildTagFor(m)
            bb = tagFolder:FindFirstChild(key)
        end
        if bb then
            local want = show and (CFG.Distance or CFG.NameTags)
            bb.Enabled = want
            if want then
                local nameLbl = bb:FindFirstChild("nameLbl")
                local distLbl = bb:FindFirstChild("distLbl")
                if nameLbl then nameLbl.Visible = CFG.NameTags end
                if distLbl then
                    distLbl.Visible = CFG.Distance
                    distLbl.Text = math.floor(d) .. "m"
                end
            end
        end
    end
end

local espTimer = 0
RunService.RenderStepped:Connect(function(dt)
    espTimer = espTimer + dt
    if espTimer >= 0.15 then
        espTimer = 0
        pcall(updateESP)
    end
end)

local function rebuildAll()
    task.wait(0.4)
    for _, m in ipairs(scanTargets()) do
        buildESPFor(m)
        buildTagFor(m)
    end
end

Players.PlayerAdded:Connect(function(pl)
    pl.CharacterAdded:Connect(rebuildAll)
    rebuildAll()
end)

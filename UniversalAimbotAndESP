-- language: Lua (Luau), file: universal_diagnostic.lua
-- JJSploit-safe on-screen diagnostic. No console. No Drawing.

local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

local gui = Instance.new("ScreenGui")
gui.Name = "UNIV_Diag"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 2147483647
gui.Parent = lp:WaitForChild("PlayerGui")

local panel = Instance.new("Frame", gui)
panel.Size = UDim2.new(0, 520, 0, 420)
panel.Position = UDim2.new(0, 20, 0, 20)
panel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel", panel)
title.Size = UDim2.new(1, -20, 0, 24)
title.Position = UDim2.new(0, 10, 0, 6)
title.BackgroundTransparency = 1
title.Text = "DIAGNOSTIC"
title.TextColor3 = Color3.fromRGB(0, 255, 170)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextXAlignment = Enum.TextXAlignment.Left

local copyBtn = Instance.new("TextButton", panel)
copyBtn.Size = UDim2.new(0, 80, 0, 22)
copyBtn.Position = UDim2.new(1, -90, 0, 6)
copyBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 128)
copyBtn.Text = "CLOSE"
copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
copyBtn.Font = Enum.Font.GothamBold
copyBtn.TextSize = 11
copyBtn.BorderSizePixel = 0
Instance.new("UICorner", copyBtn).CornerRadius = UDim.new(0, 5)
copyBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

local scroll = Instance.new("ScrollingFrame", panel)
scroll.Size = UDim2.new(1, -20, 1, -40)
scroll.Position = UDim2.new(0, 10, 0, 34)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.ScrollBarThickness = 3

local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 3)

local function line(text, color)
    local l = Instance.new("TextLabel", scroll)
    l.Size = UDim2.new(1, -8, 0, 16)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or Color3.fromRGB(220, 220, 220)
    l.Font = Enum.Font.Code
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    l.AutomaticSize = Enum.AutomaticSize.Y
    return l
end

line("=== DIAGNOSTIC ===", Color3.fromRGB(0, 255, 170))
line("players: " .. #Players:GetPlayers())

local found = 0
local function walk(c, d)
    if d > 4 then return end
    for _, ch in ipairs(c:GetChildren()) do
        if ch:IsA("Model") then
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then
                found = found + 1
                if found <= 15 then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    local head = ch:FindFirstChild("Head")
                    local ref = hrp or head
                    line(string.format("[%d] %s", found, ch.Name), Color3.fromRGB(255, 220, 100))
                    line(string.format("    HP=%s state=%s", tostring(h.Health), tostring(h:GetState())))
                    line(string.format("    parent=%s", ch.Parent and ch.Parent.Name or "nil"))
                    line(string.format("    HRP=%s Head=%s", tostring(hrp ~= nil), tostring(head ~= nil)))
                    if ref and cam then
                        local sp, on = cam:WorldToViewportPoint(ref.Position)
                        line(string.format("    screen=(%d,%d) on=%s Z=%d",
                            sp.X, sp.Y, tostring(on), sp.Z))
                    end
                end
            end
        elseif ch:IsA("Folder") then
            walk(ch, d + 1)
        end
    end
end
walk(workspace, 0)

line("")
line("humanoid models: " .. found, Color3.fromRGB(0, 255, 170))
line("your char: " .. (lp.Character and lp.Character.Name or "none"))
line("camera type: " .. tostring(cam.CameraType))
line("viewport: " .. cam.ViewportSize.X .. "x" .. cam.ViewportSize.Y)
line("")
line("screenshot this panel and send it.", Color3.fromRGB(255, 100, 100))

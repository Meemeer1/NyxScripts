local function refreshConsole()
    for _, c in ipairs(conScroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    conLine("=== RIVALS TARGET DUMP ===", C.consoleOk)
    local vp = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    conLine(string.format("viewport: %dx%d  center:(%d,%d)", vp.X, vp.Y, cx, cy), C.textMid)
    conLine(string.format("camera: %s  your char: %s", tostring(cam.CameraType), lp.Character and lp.Character.Name or "none"), C.textMid)
    conLine(string.format("aim fov: %d px   maxdist: %d studs", CFG.AimbotFOV, CFG.MaxDist), C.textMid)
    conLine("")
    local n = 0
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then
            n = n + 1
            local ch = pl.Character
            local h = ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            local head = ch:FindFirstChild("Head")
            if h and hrp and head then
                local ref = ch:FindFirstChild(CFG.AimbotPart) or hrp
                local sp = cam:WorldToViewportPoint(ref.Position)
                local sd = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
                local d = (cam.CFrame.Position - ref.Position).Magnitude
                local inFOV = sd <= CFG.AimbotFOV
                local alive = h.Health > 0 and h:GetState() ~= Enum.HumanoidStateType.Dead
                local col = C.consoleErr
                if alive and inFOV then col = C.consoleOk
                elseif alive then col = C.consoleWarn end
                conLine(string.format("[%d] %s  hp=%s", n, pl.Name, tostring(math.floor(h.Health))), col)
                conLine(string.format("     fovDist=%d (limit %d)  studs=%d", math.floor(sd), CFG.AimbotFOV, math.floor(d)), col)
                conLine(string.format("     screen=(%d,%d)  state=%s", sp.X, sp.Y, tostring(h:GetState()):gsub("Enum.HumanoidStateType.", "")), col)
            end
        end
    end
    if n == 0 then conLine("no other players detected", C.consoleErr) end
    conLine("")
    conLine("green = alive + inside FOV", C.consoleOk)
    conLine("yellow = alive but outside FOV (raise FOV)", C.consoleWarn)
    conLine("red = dead / filtered", C.consoleErr)
end

conRefreshBtn.MouseButton1Click:Connect(refreshConsole)

